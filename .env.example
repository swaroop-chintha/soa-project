# ==============================================================================
# Aegis Claims System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting production deployments:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env containing real credentials or secrets to version control!
# ==============================================================================

# Active Spring Profile: dev (H2 in-memory) or prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# JWT Configuration (Ensure JWT_SECRET is a secure 256-bit+ random string in production)
JWT_SECRET=CHANGE_ME_TO_A_VERY_SECURE_256BIT_SECRET_KEY_FOR_AEGIS_PRODUCTION_USE
JWT_EXPIRATION_MS=86400000

# Service Discovery
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/

# Service Ports (Host bindings)
EUREKA_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8084
POLICY_PORT=8081
CLAIM_PORT=8082
APPROVAL_PORT=8083

# Production Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DATABASE_USERNAME=aegis_admin
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=postgres

# Database Connection Pool (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONN_TIMEOUT=10000

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Gateway Rate Limiting (Permits per minute on /auth/login)
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW=60

# Production User Passwords (Never use defaults in production!)
AUTH_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTH_USER_PASSWORD=CHANGE_ME_USER_PASSWORD

# Resilience4j Timeouts & Thresholds
TIMEOUT_POLICY_SERVICE=3s
TIMEOUT_APPROVAL_SERVICE=3s
RETRY_POLICY_MAX_ATTEMPTS=3
RETRY_APPROVAL_MAX_ATTEMPTS=2
CB_POLICY_WINDOW_SIZE=10
CB_POLICY_MIN_CALLS=5
CB_POLICY_FAIL_RATE=50
CB_POLICY_WAIT_OPEN=5s
CB_APPROVAL_WINDOW_SIZE=10
CB_APPROVAL_MIN_CALLS=5
CB_APPROVAL_FAIL_RATE=50
CB_APPROVAL_WAIT_OPEN=5s

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
